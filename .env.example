# Copia este archivo como .env en la raíz del proyecto y pon tu cadena de conexión de MongoDB Atlas.
# El archivo .env está en .gitignore, así que tus credenciales no se suben al repositorio.
# El nombre de la base de datos (tvmaze) va después del host.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/tvmaze?retryWrites=true&w=majority
